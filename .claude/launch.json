{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wfh-employee",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && pnpm exec nest build && node --enable-source-maps dist/apps/employee/main.js"
      ],
      "port": 8101
    },
    {
      "name": "wfh-attendance",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && node --enable-source-maps dist/apps/attendance/main.js"
      ],
      "port": 8102
    },
    {
      "name": "wfh-gateway",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd backend && node --enable-source-maps dist/apps/gateway/main.js"
      ],
      "port": 8100
    },
    {
      "name": "wfh-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev",
        "--port",
        "3100"
      ],
      "port": 3100
    }
  ]
}
