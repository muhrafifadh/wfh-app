{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hadirin-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "backend",
        "dev"
      ],
      "env": {
        "REGISTRATION_ENABLED": "false",
        "CORS_ORIGINS": "http://localhost:3000,http://localhost:3001"
      },
      "port": 8000
    },
    {
      "name": "hadirin-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev",
        "--port",
        "3001"
      ],
      "env": {
        "REGISTRATION_ENABLED": "false",
        "NEXT_PUBLIC_APP_URL": "http://localhost:3001"
      },
      "port": 3001
    }
  ]
}
