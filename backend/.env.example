NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# docker compose up -d (change the ports below if they clash with other projects)
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
REDIS_PORT=6379
REDIS_TEST_PORT=6380
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hadirin?schema=public
REDIS_URL=redis://localhost:6379
# BullMQ key prefix (tests use their own)
QUEUE_PREFIX=bull

# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Proxies allowed to set X-Forwarded-For: "loopback", CIDRs, or a hop count.
# The frontend calls the backend server-to-server, so it must be listed here.
TRUST_PROXY=loopback

# Dev seed user (pnpm db:seed). Development only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-with-a-dev-only-password
# Password of the Hadir.in demo accounts (manager, employees, HR). Defaults to SEED_ADMIN_PASSWORD.
# SEED_DEMO_PASSWORD=

# Links in emails point here
FRONTEND_URL=http://localhost:3000
# Public sign-up (POST /v1/auth/register). Off for Hadir.in: Admin/HR invites accounts.
REGISTRATION_ENABLED=false
# smtp (real delivery), console (dev: prints emails, links included), memory (tests), disabled
MAIL_TRANSPORT=console
# For MAIL_TRANSPORT=smtp. Dev inbox: docker compose --profile mail up -d → smtp://localhost:1025
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Boilerplate <no-reply@localhost>
# Mailpit ports (change if they clash with another project)
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Object storage (S3-compatible). Local: the storage container (RustFS), console at http://localhost:9001
S3_BUCKET=uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_FORCE_PATH_STYLE=true
