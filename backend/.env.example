NODE_ENV=development
# The gateway: the only port clients use
PORT=8100
EMPLOYEE_SERVICE_PORT=8101
ATTENDANCE_SERVICE_PORT=8102
EMPLOYEE_SERVICE_URL=http://127.0.0.1:8101
ATTENDANCE_SERVICE_URL=http://127.0.0.1:8102
# Private TCP calls from the attendance service. No authentication: never expose this port.
EMPLOYEE_RPC_HOST=127.0.0.1
EMPLOYEE_RPC_PORT=8111
LOG_LEVEL=debug

# docker compose up -d (change the ports below if they clash with other projects)
POSTGRES_PORT=5444
POSTGRES_TEST_PORT=5445
REDIS_PORT=6390
REDIS_TEST_PORT=6381
STORAGE_PORT=9010
STORAGE_CONSOLE_PORT=9011
EMPLOYEE_DATABASE_URL=postgresql://postgres:postgres@localhost:5444/wfh_employee?schema=public
ATTENDANCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5444/wfh_attendance?schema=public
REDIS_URL=redis://localhost:6390
# BullMQ key prefix (tests use their own)
QUEUE_PREFIX=bull

# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3100
# Proxies allowed to set X-Forwarded-For: "loopback", CIDRs, or a hop count.
# The frontend calls the backend server-to-server, so it must be listed here.
TRUST_PROXY=loopback

# Dev seed user (pnpm db:seed). Development only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-with-a-dev-only-password
# Password of the Hadir.in demo accounts (manager, employees, HR). Defaults to SEED_ADMIN_PASSWORD.
# SEED_DEMO_PASSWORD=

# Links in emails point here
FRONTEND_URL=http://localhost:3100
# Public sign-up (POST /v1/auth/register). Off for Hadir.in: Admin/HR invites accounts.
REGISTRATION_ENABLED=false
# smtp (real delivery), console (dev: prints emails, links included), memory (tests), disabled
MAIL_TRANSPORT=console
# For MAIL_TRANSPORT=smtp. Dev inbox: docker compose --profile mail up -d → smtp://localhost:1025
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Boilerplate <no-reply@localhost>
# Mailpit ports (change if they clash with another project)
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Lets organizations turn on location and selfie checks. On here so a local setup asks for the photo;
# set it to false in production until the deferred requirements in
# docs/ATTENDANCE_VERIFICATION_PLAN.md section 4 are met. Match the frontend.
VERIFICATION_ENABLED=true

# Object storage (S3-compatible). Local: the storage container (RustFS), console at http://localhost:9011
S3_BUCKET=uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_FORCE_PATH_STYLE=true
