{
  "name": "wfh-app-backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && nest build",
    "dev": "nest build && pnpm run --parallel \"/^dev:/\"",
    "lint": "oxlint --type-aware .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "NODE_ENV=test pnpm db:deploy && vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate --config prisma.employee.config.ts && prisma generate --config prisma.attendance.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma.employee.config.ts && prisma migrate deploy --config prisma.attendance.config.ts",
    "postinstall": "pnpm db:generate",
    "prepare": "cd .. && husky",
    "db:seed": "tsx prisma/seed.ts",
    "openapi": "nest build && NODE_ENV=test node dist/scripts/export-openapi.js",
    "dev:build": "nest build --watch",
    "dev:employee": "node --watch --enable-source-maps dist/apps/employee/main.js",
    "dev:attendance": "node --watch --enable-source-maps dist/apps/attendance/main.js",
    "dev:gateway": "node --watch --enable-source-maps dist/apps/gateway/main.js",
    "db:migrate:employee": "prisma migrate dev --config prisma.employee.config.ts",
    "db:migrate:attendance": "prisma migrate dev --config prisma.attendance.config.ts",
    "db:studio:employee": "prisma studio --config prisma.employee.config.ts",
    "db:studio:attendance": "prisma studio --config prisma.attendance.config.ts",
    "db:resync": "nest build && node dist/scripts/resync-directory.js",
    "start:employee": "node dist/apps/employee/main.js",
    "start:attendance": "node dist/apps/attendance/main.js",
    "start:gateway": "node dist/apps/gateway/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.5.0",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.1",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "smtp-server": "^3.21.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.22.0"
}
