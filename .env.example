NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# docker compose up -d (change the ports below if they clash with other projects)
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
REDIS_PORT=6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Proxies allowed to set X-Forwarded-For: "loopback", CIDRs, or a hop count.
# The frontend calls the backend server-to-server, so it must be listed here.
TRUST_PROXY=loopback

# Dev seed user (pnpm db:seed). Development only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-with-a-dev-only-password

# Links in emails point here
FRONTEND_URL=http://localhost:3000
# Public sign-up (POST /v1/auth/register)
REGISTRATION_ENABLED=true
# console (dev: prints emails, links included), memory (tests), disabled (production for now)
MAIL_TRANSPORT=console
