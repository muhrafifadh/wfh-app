{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc", "node", "vitest"],
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist", "coverage", "src/generated"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description"
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "no-console": "error",
    "node/no-process-env": "error",
    "import/no-default-export": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../*"],
            "message": "Use the @/ alias instead of ../ imports."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/config/**", "prisma.config.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["*.config.ts", "*.config.*.ts", "*.config.mjs"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["prisma/**"],
      "rules": {
        "node/no-process-env": "off",
        "no-restricted-imports": "off",
        "no-console": "off"
      }
    }
  ]
}
