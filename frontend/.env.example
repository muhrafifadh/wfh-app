# Backend base URL including the version prefix (server only)
API_URL=http://localhost:8000/v1
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-plus-random-characters
# Public URL of this app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Show the sign-up page (match the backend's REGISTRATION_ENABLED). Off for Hadir.in:
# accounts are created by Admin/HR invitations.
REGISTRATION_ENABLED=false
# Shows one-click test personas on the login page (server only). Leave empty to hide them; never
# set it where real people sign in. Use the backend's seed password: every persona needs it, so
# SEED_DEMO_PASSWORD and SEED_ADMIN_PASSWORD must match for the owner persona to work.
DEMO_LOGIN_PASSWORD=
# Error tracking (Sentry). Leave empty to turn it off.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload, for readable stack traces. Optional.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
