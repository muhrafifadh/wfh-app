NODE_ENV=test
PORT=8001
LOG_LEVEL=warn
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hadirin_test?schema=public
# The redis-test container, and its own key prefix, so a dev server never picks up test jobs
REDIS_URL=redis://localhost:6380
QUEUE_PREFIX=test
JWT_ACCESS_SECRET=test-secret-test-secret-test-secret-1234
CORS_ORIGINS=http://localhost:3000
# Proxies allowed to set X-Forwarded-For: "loopback", CIDRs, or a hop count.
# The frontend calls the backend server-to-server, so it must be listed here.
TRUST_PROXY=loopback

# Links in emails point here
FRONTEND_URL=http://localhost:3000
# Public sign-up (POST /v1/auth/register)
REGISTRATION_ENABLED=true
# console (dev: prints emails, links included), memory (tests), disabled (production for now)
MAIL_TRANSPORT=memory

# Object storage (S3-compatible). Local: the storage container (RustFS), console at http://localhost:9001
S3_BUCKET=uploads-test
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_FORCE_PATH_STYLE=true
