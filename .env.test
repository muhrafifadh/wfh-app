NODE_ENV=test
PORT=8001
LOG_LEVEL=warn
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_test?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=test-secret-test-secret-test-secret-1234
CORS_ORIGINS=http://localhost:3000
# Proxies allowed to set X-Forwarded-For: "loopback", CIDRs, or a hop count.
# The frontend calls the backend server-to-server, so it must be listed here.
TRUST_PROXY=loopback

# Links in emails point here
FRONTEND_URL=http://localhost:3000
# Public sign-up (POST /v1/auth/register)
REGISTRATION_ENABLED=true
# console (dev: prints emails, links included), memory (tests), disabled (production for now)
MAIL_TRANSPORT=memory
